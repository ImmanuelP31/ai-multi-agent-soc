# Local-only Compose configuration. Copy this file to .env before starting.
POSTGRES_USER=socuser
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=socdb

BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/live-alerts

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
REDIS_HOST=redis
REDIS_PORT=6379

# Clean clones run honestly in explicit demo modes because generated artifacts
# are not committed. Enable ML/required modes only after producing the documented files.
DETECTION_MODE=rule_based
ANOMALY_MODEL_BUNDLE=/app/ml/models/anomaly_bundle.joblib
SEQUENCE_PREDICTION_MODE=optional
SEQUENCE_ARTIFACT_DIR=/app/ml/sequence_detection
SEQUENCE_STATE_TTL_SECONDS=3600

# Used only by docker-compose.dev.yml when host access to infrastructure is needed.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
ZOOKEEPER_HOST_PORT=2181
KAFKA_HOST_PORT=9094
